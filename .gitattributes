# Normalise line endings to LF in the repo and working trees.
#
# Without this, `core.autocrlf=true` on Windows checkouts wrote CRLF files that
# Prettier (endOfLine: lf) then flagged on every line — ~39k auto-fixable lint
# errors burying the ~300 real ones. Forcing LF everywhere makes `npm run lint`
# a useful gate again.
#
# After adding this, run once (isolated commit): `npm run format` then
# `git add --renormalize .`
* text=auto eol=lf

# Binary assets — never line-ending conversion, never diffing.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.avif binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.mp4 binary
*.webm binary

# Text files that must keep LF explicitly (generated / web).
*.svg text eol=lf
*.webmanifest text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.sql text eol=lf
*.md text eol=lf
