# =============================================================================
# Spaces1 — environment contract
#
# One section per trust boundary. Every key below is read by code; every key
# read by code appears here. Copy to `.env` (never committed) for local dev;
# in production use Cloudflare Worker secrets / `.dev.vars` for the Server block.
#
#   Browser  = VITE_*  → inlined into the public JS bundle at BUILD time.
#              NEVER put a secret in this section: anyone can read the bundle.
#   Server   = read via src/lib/env.server.ts. Private; never shipped to the
#              client. There are no BACKEND_* or LOVABLE_* aliases — use the
#              canonical names below.
# =============================================================================

# -----------------------------------------------------------------------------
# Browser (baked into the bundle at build time — PUBLIC by definition)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT

VITE_APP_NAME=Spaces1
VITE_APP_TAGLINE=Discover new ideas and connect
VITE_SUPPORT_EMAIL=support@example.com
VITE_APP_ENV=development

VITE_MEDIA_BUCKET=media
VITE_MAX_UPLOAD_MB=25
VITE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
VITE_PAYSTACK_PUBLIC_KEY=pk_test_...

# Feed / composer limits
VITE_FEED_PAGE_SIZE=20
VITE_FEED_MAX_PAGE_SIZE=100
VITE_STORY_TTL_HOURS=24
VITE_MAX_POST_LENGTH=500
VITE_MAX_STORY_LENGTH=220
VITE_FEATURE_STORIES=true

# AI (browser-visible model NAMES only — the key is server-side)
VITE_AI_TEXT_MODEL=google/gemini-2.5-flash
VITE_AI_IMAGE_MODEL=google/gemini-2.5-flash-image

# Live audio (Spaces) tuning — public, non-secret. TURN is configured entirely
# server-side (TURN_REST_* below) and delivered as short-lived ephemeral
# credentials at call time; there are no browser TURN keys (plan §S4).
VITE_SPACES_MESH_MAX=8
VITE_SPACES_SFU_PROVIDER=
VITE_SPACES_SFU_URL=
VITE_SPACES_RECORDING_MAX_MB=100

# Feature flags (true/false)
VITE_FEATURE_SPACES=true
VITE_FEATURE_MESSAGING=true
VITE_FEATURE_TIPPING=true
VITE_FEATURE_AI=true
VITE_FEATURE_DEVELOPER_PORTAL=true
VITE_FEATURE_WORKSPACES=true

# -----------------------------------------------------------------------------
# Server only — read via src/lib/env.server.ts (private, never in the bundle)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Any OpenAI-compatible chat completions endpoint (no vendor default).
# Example below is Google Gemini's OpenAI-compatible endpoint (works with a
# "AIza..."/Gemini API key). Swap for OpenAI/other by changing gateway+model.
AI_API_KEY=
AI_GATEWAY_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_TEXT_MODEL=gemini-2.5-flash

# Developer API — API_KEY_PEPPER is REQUIRED in production and must be >= 32
# chars (`openssl rand -hex 32`). Rotating it invalidates existing API keys.
API_KEY_PEPPER=
CRON_SECRET=
WEBHOOK_MAX_ATTEMPTS=6
# Comma-separated browser origins allowed to call /api/public/v1 with CORS.
ALLOWED_API_ORIGINS=

# Security headers (S7). Set CSP_REPORT_ONLY=true for the first deploy week.
APP_ENV=development
CSP_REPORT_ONLY=false

# Payments
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_CURRENCY=KES
PAYSTACK_USD_RATE=130

# Ephemeral TURN (RFC 5766) — server mints short-lived credentials; the shared
# secret never reaches the browser. Two supported modes, chosen by TURN_REST_URL:
#   • a `turn:`/`stun:` URL  -> coturn static-auth-secret (HMAC-SHA1) — set
#     TURN_REST_API_KEY to the coturn realm's shared secret.
#   • an `http(s)://` URL    -> a REST credential service (Twilio/Metered) POSTed
#     with HTTP Basic (username:apiKey); its JSON response is normalised.
# Leave blank for STUN-only. Populated when TURN is enabled (roadmap M4).
TURN_REST_URL=
TURN_REST_USERNAME=
TURN_REST_API_KEY=
TURN_TTL_SECONDS=3600

# Server-side media storage (R2 preferred; falls back to Supabase 'media' bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
MEDIA_MAX_IMAGE_MB=25
MEDIA_MAX_VIDEO_MB=100
MEDIA_MAX_AUDIO_MB=100

# -----------------------------------------------------------------------------
# Not yet implemented (tracked in the remediation plan, milestone M6/M8)
# -----------------------------------------------------------------------------
# Stripe is declared for the future but no Stripe code exists yet; leave unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
