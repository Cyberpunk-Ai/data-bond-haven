# ---------- Browser (baked in at build time) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT

VITE_APP_NAME=Spaces1
VITE_APP_TAGLINE=Where creators gather, talk and get paid.
VITE_SUPPORT_EMAIL=support@example.com
VITE_MEDIA_BUCKET=media
VITE_MAX_UPLOAD_MB=25
VITE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
VITE_PAYSTACK_PUBLIC_KEY=pk_live_...

# Live audio (Spaces). TURN is strongly recommended in production.
VITE_TURN_URL=turn:turn.example.com:3478
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
VITE_SPACES_MESH_MAX=8
# Large rooms: set a provider + URL and register an SfuAdapter (see src/hooks/useSpaceAudio.ts)
VITE_SPACES_SFU_PROVIDER=
VITE_SPACES_SFU_URL=

# Feature flags (true/false)
VITE_FEATURE_SPACES=true
VITE_FEATURE_MESSAGING=true
VITE_FEATURE_TIPPING=true
VITE_FEATURE_AI=true
VITE_FEATURE_DEVELOPER_PORTAL=true
VITE_FEATURE_WORKSPACES=true

# ---------- Server only (never exposed to the browser) ----------
# SUPABASE_* or BACKEND_* names are both accepted.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Any OpenAI-compatible chat completions endpoint
AI_API_KEY=
AI_GATEWAY_URL=https://api.openai.com/v1/chat/completions
AI_TEXT_MODEL=gpt-4o-mini

# Developer API
API_KEY_PEPPER=long-random-string
CRON_SECRET=long-random-string
WEBHOOK_MAX_ATTEMPTS=6

# Payments
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_CURRENCY=KES
PAYSTACK_USD_RATE=130
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
