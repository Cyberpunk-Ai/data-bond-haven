# =============================================================================
# Spaces1 — environment contract
#
# One section per trust boundary. Every key below is read by code; every key
# read by code appears here. Copy to `.env` (never committed) for local dev;
# in production use Cloudflare Worker secrets / `.dev.vars` for the Server block.
#
#   Browser  = VITE_*  → inlined into the public JS bundle at BUILD time.
#              NEVER put a secret in this section: anyone can read the bundle.
#   Server   = read via src/lib/env.server.ts (and src/lib/storage/* for object
#              stores). Private; never shipped to the client. There are no
#              BACKEND_* or LOVABLE_* aliases — use the canonical names below.
# =============================================================================

# -----------------------------------------------------------------------------
# Browser (baked into the bundle at build time — PUBLIC by definition)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT

VITE_APP_NAME=Spaces1
VITE_APP_TAGLINE=Discover new ideas and connect
VITE_SUPPORT_EMAIL=support@example.com
VITE_APP_ENV=development

VITE_MEDIA_BUCKET=media
VITE_PAYSTACK_PUBLIC_KEY=pk_test_...

# Feed / composer limits
VITE_FEED_PAGE_SIZE=20
VITE_FEED_MAX_PAGE_SIZE=100
# Composer character cap (the server independently rejects posts over 5000).
VITE_MAX_POST_LENGTH=1000
VITE_FEATURE_STORIES=true

# Live audio (Spaces) tuning — public, non-secret. TURN is configured entirely
# server-side (TURN_REST_* below) and delivered as short-lived ephemeral
# credentials at call time; there are no browser TURN keys (plan §S4).
VITE_SPACES_MESH_MAX=8
VITE_SPACES_SFU_PROVIDER=
VITE_SPACES_SFU_URL=
VITE_SPACES_RECORDING_MAX_MB=100

# Feature flags (true/false)
VITE_FEATURE_SPACES=true
VITE_FEATURE_MESSAGING=true
VITE_FEATURE_TIPPING=true
VITE_FEATURE_AI=true
VITE_FEATURE_DEVELOPER_PORTAL=true
VITE_FEATURE_WORKSPACES=true
# Sign-in providers. false hides the "Continue with Google" button on the auth
# form, leaving email signup and login only — it changes nothing else on the
# page. People who already signed up with Google keep signing in with their
# email, and the provider's own Google switch stays independent of this flag.
VITE_FEATURE_GOOGLE_SIGNIN=true

# -----------------------------------------------------------------------------
# Server only — read via src/lib/env.server.ts (private, never in the bundle)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
# If that host does not resolve from your network (Supabase IP-blocks the direct
# db.* host), use the session pooler instead - note the dot in the username:
#   postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Bind address for the built server (`npm start` / `npm run preview`). Both are
# optional - defaults are port 3000 on every interface. The dev server's port
# lives in vite.config.ts (8080). Override for one run: npm start -- --port 3005
PORT=3000
# HOST=0.0.0.0

# Any OpenAI-compatible chat completions endpoint (no vendor default).
# Example below is Google Gemini's OpenAI-compatible endpoint (works with a
# "AIza..."/Gemini API key). Swap for OpenAI/other by changing gateway+model.
AI_API_KEY=
AI_GATEWAY_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_TEXT_MODEL=gemini-2.5-flash

# Server secrets. API_KEY_PEPPER is not just a Developer API concern: in
# production env.server.ts refuses to build at all while it is missing or under
# 32 chars, and every handler that reads server env then fails — Paystack
# charges and verification, payouts and the vault key, AI drafting, TURN, API
# key hashing. Symptom: each of those requests 500s at the first `env()` call
# while the site otherwise looks fine. Generate with `openssl rand -hex 32`;
# rotating it invalidates existing API keys, so re-issue them afterwards.
API_KEY_PEPPER=
# Shared secret for /api/public/cron/* and /api/public/webhooks/dispatch.
# Schedulers send `Authorization: Bearer $CRON_SECRET`; verification fails
# closed, so an unset value silently locks every scheduled job out (media
# garbage collection and outbound webhook delivery stop running).
CRON_SECRET=
WEBHOOK_MAX_ATTEMPTS=6
# HMAC key for the short-lived ?mt= tokens that let <audio>/<video>/<img>
# reach private media (DM attachments, Space replays, stories). Optional: it
# derives from SUPABASE_SERVICE_ROLE_KEY when unset, but a dedicated secret lets
# you rotate media access without touching the database key.
MEDIA_TOKEN_SECRET=
# Composer location labels. The lookup runs on the server (lib/geo.functions.ts)
# and forwards the typed place name to this OpenStreetMap-compatible endpoint, so
# the browser never needs a third-party host in the CSP's connect-src and the
# outbound request can carry the identifying User-Agent Nominatim's usage policy
# requires. Defaults to https://nominatim.openstreetmap.org/search when unset; the
# old VITE_GEOCODER_URL name is still read. Respect the public service's 1 req/s
# limit - point this at your own geocoder instance if location tagging grows.
GEOCODER_URL=
# Comma-separated browser origins allowed to call /api/public/v1 with CORS.
# Production (spaces1.com) — include the apex and www, plus any dev origins you
# still test from. Server-to-server / cURL callers send no Origin and are fine.
ALLOWED_API_ORIGINS=https://spaces1.com,https://www.spaces1.com

# Security headers (S7). APP_ENV=production turns on enforced CSP, HSTS and
# X-Frame-Options — set it on the deployed spaces1.com environment, keep
# `development` locally. Flip CSP_REPORT_ONLY=true for the first deploy week.
APP_ENV=development
CSP_REPORT_ONLY=false

# -----------------------------------------------------------------------------
# Production domain (https://spaces1.com)
#
# No env key holds the domain: every auth/verify/reset redirect is built from
# window.location.origin at runtime, so one build serves localhost, previews and
# spaces1.com. The provider-side entries (Supabase Site URL + Redirect URLs,
# Google authorized origins/redirect URI, Paystack domains) are listed in the
# "Connecting the production domain" section of README.md — copy them from there.
#
# What IS configured here is which origins the server trusts as its own public
# address. ALLOWED_API_ORIGINS drives both the Developer API CORS allowlist and
# the Paystack `<origin>/billing/callback` redirect pinning: a reported origin
# that is not on the list (and is not the origin that served the request) is
# replaced by the deployment's own address, so a crafted call cannot send a
# payer to a look-alike domain. Loopback origins always pass (no env churn in dev).
# -----------------------------------------------------------------------------

# Payments
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_CURRENCY=KES
PAYSTACK_USD_RATE=130

# Ephemeral TURN (RFC 5766) — server mints short-lived credentials; the shared
# secret never reaches the browser. Two supported modes, chosen by TURN_REST_URL:
#   • a `turn:`/`stun:` URL  -> coturn static-auth-secret (HMAC-SHA1) — set
#     TURN_REST_API_KEY to the coturn realm's shared secret.
#   • an `http(s)://` URL    -> a REST credential service (Twilio/Metered) POSTed
#     with HTTP Basic (username:apiKey); its JSON response is normalised.
# Leave blank for STUN-only. Populated when TURN is enabled (roadmap M4).
TURN_REST_URL=
TURN_REST_USERNAME=
TURN_REST_API_KEY=
TURN_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Object storage (media: avatars, posts, stories, DM attachments, Space replays)
#
# The app talks to one StorageProvider interface, never to a vendor. Which
# implementation is used is decided here, so switching stores is: fill in the
# block below, restart, done — existing uploads keep working because every
# stored value is a key that the proxy re-resolves against the live backend.
#
#   STORAGE_PROVIDER = auto (default) | s3 | supabase
#     auto     -> S3-compatible store when credentials exist, else Supabase
#     s3       -> force the S3 block below (loud console error if incomplete)
#     supabase -> force the Supabase 'media' bucket
#
# Any S3-compatible endpoint works: Cloudflare R2, Backblaze B2, DigitalOcean
# Spaces, Wasabi, MinIO, AWS S3. Fill in EITHER the generic names OR (for R2)
# just the four R2_* aliases — they are read as one config, S3_* wins:
#   R2_ACCOUNT_ID + R2_BUCKET + R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY
# with STORAGE_PROVIDER=auto is the whole recipe; the endpoint is derived.
#
# Switching stores keeps every stored reference working, because rows hold bucket
# keys (never a vendor URL) and the proxy resolves them against the live backend.
# Objects uploaded before the switch still only exist in the OLD bucket, so keep
# the old credentials in place until you have copied them across: Admin ->
# System settings -> Storage backend -> "Check what's missing", then "Copy legacy
# objects" (idempotent, nothing overwritten or deleted). Only delete the old
# credentials once that reports everything drained.
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2/B2/Spaces want their own region string; R2 uses "auto".
S3_REGION=auto
# true (default) puts the bucket in the path: endpoint/bucket/key. Set false
# for providers that require bucket-in-hostname addressing (AWS S3).
S3_PATH_STYLE=true
# Cloudflare R2 shortcut: with only R2_ACCOUNT_ID set, S3_ENDPOINT is derived
# as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com — so these four lines are
# a complete R2 setup. Each has an S3_* twin above (S3_ACCOUNT_ID, S3_REGION,
# S3_PUBLIC_BASE_URL …); the S3_* name wins when both are set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_PUBLIC_BASE_URL=
# Optional read-only public/CDN hostname for the bucket (R2 "public bucket"
# domain, B2 CDN, CloudFront, …). Only used for avatars/posts/media — never for
# DM attachments, stories or recordings, which always stream through the
# authorized proxy. CAREFUL: a public bucket domain serves the WHOLE bucket, so
# only point it at a bucket whose keys are all unguessable and non-sensitive.
S3_PUBLIC_BASE_URL=
# Must be "true" as well as a base URL above before any media is redirected to
# that domain. Off by default: streaming through the app is always safe.
MEDIA_PUBLIC_CDN=false

# Supabase bucket name when STORAGE_PROVIDER falls back to Supabase.
SUPABASE_MEDIA_BUCKET=media

# Upload caps enforced at /api/uploads (the stricter of these and the caller's
# plan limit wins; the admin console's max_upload_size_mb is the platform cap).
MEDIA_MAX_IMAGE_MB=25
MEDIA_MAX_VIDEO_MB=100
MEDIA_MAX_AUDIO_MB=100
MEDIA_MAX_DOC_MB=25

# -----------------------------------------------------------------------------
# Not yet implemented (tracked in the remediation plan, milestone M6/M8)
# -----------------------------------------------------------------------------
# Stripe is declared for the future but no Stripe code exists yet; leave unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
