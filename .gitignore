# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Single lockfile: the repo standardises on bun (bun.lock + bunfig.toml).
# Ignore any other package manager's lock so the tree can't drift to two again.
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment — never commit real secrets. Only the .example template is tracked.
.env
.env.local
.env.*.local
!.env.example

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Supabase CLI local temp state
supabase/.temp/
